# pumpkins LLM 설정 — 이 파일을 복사해서 시작하세요:
#     cp .env.example .env
# .env는 .gitignore에 등록되어 있어 커밋되지 않습니다. 실제 키는 .env에만 적으세요.
# 셸/CI에서 export한 실제 환경변수가 .env보다 우선합니다 (override=False).
# 설계: docs/llm-provider-and-keys-design.md

# 사용할 프로바이더: anthropic | openai
LLM_PROVIDER=anthropic

# 쓰는 쪽 키만 채우면 됩니다.
ANTHROPIC_API_KEY=sk-ant-...
OPENAI_API_KEY=sk-...
